# Port HTTP API
PORT=4000

# Mode runtime: development | production | test
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_site

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h

# TTL pembayaran (detik)
QR_TTL_SECONDS=120
EMONEY_TTL_SECONDS=90

# CORS, pisahkan dengan koma bila lebih dari satu origin. * untuk semua origin.
# Di produksi CORS_ORIGIN=* ditolak — daftarkan origin secara eksplisit.
CORS_ORIGIN=*

# Logging (pino): fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Rate limit login: maksimal pintu masuk per jendela waktu (menit)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
