{
  "name": "pos-site-server",
  "version": "0.1.0",
  "description": "Site Server test untuk POS Parkir (track backend)",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "seed": "tsx src/db/seed.ts",
    "setup": "npm run generate && npm run db:push && npm run seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
